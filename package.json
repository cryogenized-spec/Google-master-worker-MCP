{
  "name": "google-master-worker-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Personal modular TypeScript Google Workspace MCP and HTTP gateway",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run test",
    "dev:worker": "wrangler dev",
    "types:worker": "wrangler types",
    "cloudflare:prepare": "node scripts/prepare-cloudflare.mjs",
    "cloudflare:verify": "node scripts/prepare-cloudflare.mjs --verify"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7",
    "@cloudflare/workers-oauth-provider": "1.2.4"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "wrangler": "4.159.0",
    "@cloudflare/workers-types": "5.20261110.1"
  }
}
